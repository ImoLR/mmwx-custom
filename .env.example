MMWXC_API_LISTEN_ADDR=127.0.0.1:12890
# Required for the independent Custom Agent management API.
MMWXC_API_TOKEN=
# Read-only official database config used to validate active browser admin sessions.
MMWXC_ADMIN_DB_CONFIG=/etc/mmwx/data/database.json
MMWXC_ALLOWED_ORIGINS=http://127.0.0.1:12890,http://localhost:12890,https://mmwxc.imgamer.top
MMWXC_FRONTEND_DIR=/opt/mmwx-custom/frontend/dist
MMWX_API_TARGET=http://127.0.0.1:12891
